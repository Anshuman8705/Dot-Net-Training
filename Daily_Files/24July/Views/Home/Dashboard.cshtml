@model Info
<h2>Welcome @ViewBag.User</h2>
<br />
<h3>Employee Details</h3>
<table class="table table-bordered" >
    <tr>
        <th>ID</th>
        <td>@Model.Id</td>
    </tr>
    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>
    <tr>
        <th>Salary</th>
        <td>@Model.Salary</td>
    </tr>
</table>
<a asp-action="Logout" class="btn btn-danger">Logout</a>